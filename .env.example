# App
APP_ENV=local
APP_BASE_URL=http://localhost:8787
DASHBOARD_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Meta WhatsApp Cloud API
META_VERIFY_TOKEN=replace-me
META_ACCESS_TOKEN=replace-me
META_PHONE_NUMBER_ID=replace-me
META_WABA_ID=replace-me
META_GRAPH_API_VERSION=v22.0

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# LLM
OPENAI_API_KEY=replace-me
OPENAI_TRANSCRIPTION_MODEL=whisper-1
AUDIO_TRANSCRIPTION_PROVIDER=huggingface
HUGGINGFACE_API_KEY=replace-me
HUGGINGFACE_TRANSCRIPTION_MODEL=openai/whisper-large-v3-turbo
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=replace-me
OPENROUTER_MODEL=openrouter/auto
AI_CONFIG_ENCRYPTION_KEY=replace-me

# Google Maps Platform
# Server-side key for Geocoding API. Restrict by API and server usage.
GOOGLE_MAPS_GEOCODING_API_KEY=replace-me
# Browser key for Maps Embed API. Restrict by HTTP referrer and API.
VITE_GOOGLE_MAPS_EMBED_API_KEY=replace-me
