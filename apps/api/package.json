{
  "name": "@42day/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "headless": "node --experimental-loader ./headless/resolve-loader.mjs --experimental-strip-types headless/cli.mjs",
    "test:headless": "node --experimental-loader ./headless/resolve-loader.mjs --test --experimental-strip-types --experimental-specifier-resolution=node test/headless-chat-*.test.mjs test/normalized-chat-use-case.test.mjs test/customer-outbound-delivery.test.mjs",
    "test:headless:integration": "node --experimental-loader ./headless/resolve-loader.mjs --test --test-concurrency=1 --experimental-strip-types --experimental-specifier-resolution=node test/headless-chat-*.test.mjs test/normalized-chat-use-case.test.mjs test/customer-outbound-delivery.test.mjs",
    "test": "node --experimental-loader ./headless/resolve-loader.mjs --test --experimental-strip-types --experimental-specifier-resolution=node test/**/*.test.mjs"
  },
  "dependencies": {
    "@42day/config": "workspace:*",
    "@42day/core": "workspace:*",
    "@42day/types": "workspace:*",
    "@rendxnn/t-router": "workspace:*",
    "hono": "^4.6.15",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
